# Stage 1: Build the React Frontend (DeployFlow Dashboard)
FROM node:18-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Setup Python FastAPI Backend
FROM python:3.10-slim
WORKDIR /app

# Install system dependencies: Git for cloning user repos, and Docker CLI to build user sites
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Copy the built frontend dashboard files into the static folder
COPY --from=frontend-build /app/frontend/dist /app/static

EXPOSE 8000

# Run FastAPI
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]